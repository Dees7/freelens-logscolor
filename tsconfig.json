{
  "compilerOptions": {
    // target — ES2022: esbuild в текущей vite про ES2024 ещё не знает и ругается
    // на каждый файл. Это про проверку типов; что попадёт в бандл, решает
    // build.target в vite.config.mjs.
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react",
    "types": ["node"],
    "paths": {
      // @freelensapp/extensions 1.10.3 на npm есть, но его d.ts — семь строк
      // реэкспорта из @freelensapp/core, а тот в `exports` поле `types` не
      // объявляет: без подсказки TS молча выдаёт `any` на весь API, и
      // единственное, что от этого ломается, — наша же типизация getLogs.
      // Декларации в пакете при этом лежат, просто по нестандартному пути.
      "@freelensapp/core/renderer": [
        "./node_modules/@freelensapp/core/static/build/library/src/renderer/library.d.ts"
      ],
      "@freelensapp/core/main": [
        "./node_modules/@freelensapp/core/static/build/library/src/main/library.d.ts"
      ]
    }
  },
  "include": ["src/**/*"]
}
